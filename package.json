{
  "name": "@base58-io/wdk-wallet-cosmos",
  "version": "1.0.0-beta.4",
  "description": "WDK module to manage BIP-44 wallets for Cosmos-compatible blockchains",
  "keywords": [
    "wdk",
    "wallet",
    "cosmos"
  ],
  "author": "Base58 <contact@base58.io> (https://base58.io)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/base58-io/wdk-wallet-cosmos.git"
  },
  "bugs": {
    "url": "https://github.com/base58-io/wdk-wallet-cosmos/issues"
  },
  "homepage": "https://github.com/base58-io/wdk-wallet-cosmos#readme",
  "files": [
    "index.js",
    "bare.js",
    "src/",
    "types/",
    "!types/tests/",
    "LICENSE",
    "README.md"
  ],
  "main": "index.js",
  "type": "module",
  "types": "./types",
  "scripts": {
    "prepublishOnly": "npm run build:types",
    "build:types": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "imports": {
    "crypto": {
      "bare": "bare-crypto",
      "default": "crypto"
    },
    "crypto/*": {
      "bare": "bare-crypto/*",
      "default": "crypto/*"
    }
  },
  "dependencies": {
    "@cosmjs/amino": "0.39.0",
    "@cosmjs/crypto": "0.39.0",
    "@cosmjs/encoding": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@tetherto/wdk-wallet": "1.0.0-beta.17",
    "bare-node-runtime": "1.5.0",
    "bip39": "3.1.0",
    "chain-registry": "2.0.251",
    "cosmjs-types": "0.11.0",
    "sodium-universal": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "bare-tls": "2.1.7"
  }
}
